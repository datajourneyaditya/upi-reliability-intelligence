{
 "datasets": [
  {
   "name": "ds_kpi",
   "displayName": "Latest month KPIs",
   "queryLines": [
    "SELECT date_format(e.period_month, 'MMM yyyy') AS month_label,\n",
    "       round(e.volume_mn / 1000, 2) AS upi_volume_bn,\n",
    "       round(e.remitter_td_pct_vw, 3) AS top50_td_pct,\n",
    "       round(e.remitter_bd_pct_vw, 2) AS top50_bd_pct,\n",
    "       round(e.est_technical_failures / 1e6, 1) AS est_tech_failures_mn,\n",
    "       (SELECT count(*) FROM upi_reliability.marts.mart_fintech_partner_health h\n",
    "         WHERE h.period_month = e.period_month AND h.degradation_alert) AS degraded_partner_sides,\n",
    "       round(e.top50_remitter_coverage * 100, 1) AS top50_coverage_pct\n",
    "FROM upi_reliability.marts.fct_ecosystem_monthly e\n",
    "WHERE e.period_month = (SELECT max(period_month) FROM upi_reliability.marts.fct_bank_monthly_performance)\n"
   ]
  },
  {
   "name": "ds_eco_rates",
   "displayName": "Ecosystem decline rates by month",
   "queryLines": [
    "SELECT period_month, round(remitter_td_pct_vw, 3) AS td_pct, round(remitter_bd_pct_vw, 2) AS bd_pct\n",
    "FROM upi_reliability.marts.fct_ecosystem_monthly WHERE remitter_td_pct_vw IS NOT NULL\n"
   ]
  },
  {
   "name": "ds_eco_volume",
   "displayName": "Ecosystem volume and failures",
   "queryLines": [
    "SELECT period_month, round(volume_mn / 1000, 2) AS upi_volume_bn,\n",
    "       round(est_technical_failures / 1e6, 1) AS est_tech_failures_mn,\n",
    "       degraded_remitter_banks, degraded_beneficiary_banks\n",
    "FROM upi_reliability.marts.fct_ecosystem_monthly WHERE period_month >= '2022-01-01'\n"
   ]
  },
  {
   "name": "ds_td_by_type",
   "displayName": "TD by bank type (metric view)",
   "queryLines": [
    "SELECT Month AS period_month, `Bank Type` AS bank_type,\n",
    "       round(MEASURE(`Technical Decline Rate`), 3) AS td_pct\n",
    "FROM upi_reliability.metrics.bank_reliability\n",
    "WHERE Role = 'remitter' AND `Bank Type` IN ('Public sector', 'Private sector', 'Small finance bank', 'Payments bank', 'Regional rural bank')\n",
    "GROUP BY ALL\n"
   ]
  },
  {
   "name": "ds_scorecard",
   "displayName": "Merchant scorecard (latest month)",
   "queryLines": [
    "SELECT reliability_rank, bank_name, bank_type, round(credits_received_mn, 1) AS credits_received_mn,\n",
    "       td_pct, round(td_pct_trailing_3m, 3) AS td_pct_3m, deemed_approved_pct, reliability_score,\n",
    "       collection_risk_tier, recommendation,\n",
    "       CASE collection_risk_tier WHEN 'Low' THEN 1 WHEN 'Medium' THEN 2 ELSE 3 END AS tier_order\n",
    "FROM upi_reliability.marts.mart_merchant_bank_scorecard\n",
    "WHERE period_month = (SELECT max(period_month) FROM upi_reliability.marts.fct_bank_monthly_performance)\n",
    "ORDER BY reliability_rank\n"
   ]
  },
  {
   "name": "ds_tier_mix",
   "displayName": "Risk tier mix by month",
   "queryLines": [
    "SELECT period_month, collection_risk_tier, count(*) AS banks\n",
    "FROM upi_reliability.marts.mart_merchant_bank_scorecard\n",
    "WHERE period_month >= '2022-07-01'\n",
    "GROUP BY ALL\n"
   ]
  },
  {
   "name": "ds_alerts",
   "displayName": "Partner alerts (latest month)",
   "queryLines": [
    "SELECT bank_name, partner_side, health_status, td_pct, round(td_pct_baseline_3m, 3) AS td_baseline_3m,\n",
    "       round(td_pct_trend_3m, 3) AS td_trend_3m, consecutive_degraded_months,\n",
    "       round(est_excess_failures_vs_baseline / 1e6, 2) AS excess_failures_mn,\n",
    "       round(volume_mn, 1) AS volume_mn\n",
    "FROM upi_reliability.marts.mart_fintech_partner_health\n",
    "WHERE period_month = (SELECT max(period_month) FROM upi_reliability.marts.fct_bank_monthly_performance) AND health_status <> 'Healthy'\n",
    "ORDER BY CASE health_status WHEN 'Critical' THEN 1 WHEN 'Degraded' THEN 2 ELSE 3 END, est_excess_failures_vs_baseline DESC\n"
   ]
  },
  {
   "name": "ds_partner_trend",
   "displayName": "Partner TD vs baseline",
   "queryLines": [
    "SELECT period_month, bank_name, partner_side, 'TD %' AS series, td_pct AS rate_pct\n",
    "FROM upi_reliability.marts.mart_fintech_partner_health\n",
    "UNION ALL\n",
    "SELECT period_month, bank_name, partner_side, '3-month baseline %', round(td_pct_baseline_3m, 3)\n",
    "FROM upi_reliability.marts.mart_fintech_partner_health WHERE td_pct_baseline_3m IS NOT NULL\n"
   ]
  },
  {
   "name": "ds_degraded_trend",
   "displayName": "Degraded partners by side",
   "queryLines": [
    "SELECT period_month, partner_side, count_if(degradation_alert) AS degraded\n",
    "FROM upi_reliability.marts.mart_fintech_partner_health WHERE period_month >= '2022-04-01'\n",
    "GROUP BY ALL\n"
   ]
  },
  {
   "name": "ds_pareto",
   "displayName": "Payer bank failure contribution (latest)",
   "queryLines": [
    "SELECT failure_contribution_rank, bank_name, bank_type,\n",
    "       round(payer_volume_share * 100, 1) AS volume_share_pct,\n",
    "       round(technical_failure_share * 100, 1) AS failure_share_pct,\n",
    "       round(cumulative_failure_share * 100, 1) AS cumulative_failure_pct,\n",
    "       td_pct, round(td_vs_market, 2) AS td_vs_market,\n",
    "       round(est_technical_failures / 1e6, 2) AS est_tech_failures_mn,\n",
    "       checkout_action\n",
    "FROM upi_reliability.marts.mart_payer_bank_checkout_risk\n",
    "WHERE period_month = (SELECT max(period_month) FROM upi_reliability.marts.fct_bank_monthly_performance)\n",
    "ORDER BY failure_contribution_rank\n"
   ]
  },
  {
   "name": "ds_pareto_top",
   "displayName": "Top 15 payer banks by failure share",
   "queryLines": [
    "SELECT failure_contribution_rank, bank_name, round(technical_failure_share * 100, 1) AS failure_share_pct,\n",
    "       round(payer_volume_share * 100, 1) AS volume_share_pct\n",
    "FROM upi_reliability.marts.mart_payer_bank_checkout_risk\n",
    "WHERE period_month = (SELECT max(period_month) FROM upi_reliability.marts.fct_bank_monthly_performance) AND failure_contribution_rank <= 15\n"
   ]
  },
  {
   "name": "ds_apps",
   "displayName": "App checkout exposure (latest)",
   "queryLines": [
    "SELECT npci_volume_rank, app_name, coalesce(parent_company, '') AS parent_company,\n",
    "       round(total_volume_mn, 1) AS volume_mn, round(volume_share * 100, 2) AS volume_share_pct,\n",
    "       coalesce((SELECT concat_ws(', ', array_sort(collect_list(d.bank_name))) FROM upi_reliability.marts.dim_bank d\n",
    "                 WHERE d.is_current AND array_contains(split(a.sponsors_reported, ', '), d.bank_id)), '') AS sponsors_reported,\n",
    "       round(sponsor_payer_td_pct, 3) AS sponsor_td_pct,\n",
    "       round(market_payer_td_pct, 3) AS market_td_pct,\n",
    "       round(indicative_technical_failures / 1e6, 2) AS indicative_failures_mn,\n",
    "       psp_risk_status\n",
    "FROM upi_reliability.marts.mart_app_checkout_risk a\n",
    "WHERE period_month = (SELECT max(period_month) FROM upi_reliability.marts.fct_bank_monthly_performance) AND volume_share >= 0.001\n",
    "ORDER BY npci_volume_rank\n"
   ]
  }
 ],
